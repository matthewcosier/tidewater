{
  "name": "tidewater",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5189",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/start.mjs",
    "test": "npm run test:physics && node test/rally-bridge.mjs && node --test test/tyre-tracks.mjs test/rally-network.mjs test/damage.mjs test/ferry-road.mjs test/ferry-mooring.mjs && node test/game-logic.mjs && node test/engine-smoke.mjs && npm run test:rally",
    "test:rally": "playwright test",
    "test:physics": "cargo test --locked --manifest-path rally-physics/Cargo.toml -j 6",
    "build:rally": "node tools/rally/build.mjs",
    "sync:rally": "node tools/rally/sync.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "^8.3.0",
    "webgpu": "^0.6.1"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "ws": "8.21.3"
  }
}
